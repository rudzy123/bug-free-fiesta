# Local development placeholders. Copy to `.env` and keep secrets out of git.
# These values are for Docker Compose on a developer machine only.

NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=1mb
CORRELATION_ID_HEADER=x-correlation-id
SHUTDOWN_TIMEOUT_MS=10000

# Account-user authentication (see docs/security/authentication-setup.md)
# local is for development/test only. Production must use oidc with operator-supplied credentials.
AUTH_PROVIDER=local
AUTH_LOCAL_SHARED_SECRET=local-dev-only-shared-secret
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SESSION_COOKIE_NAME=esign_sid
AUTH_CSRF_COOKIE_NAME=esign_csrf
AUTH_CSRF_HEADER_NAME=x-csrf-token
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
# OIDC placeholders — replace with values from your identity provider. Not working production config.
# AUTH_PROVIDER=oidc
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_REDIRECT_URI=

# Web (Next.js inlines NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Worker
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4100
WORKER_POLL_INTERVAL_MS=5000

# Document ingestion (PDF only). Proxy, API, and object-storage max size must match.
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_UPLOAD_TTL_SECONDS=900
DOCUMENT_PREVIEW_TTL_SECONDS=120
DOCUMENT_INSPECTOR=local
DOCUMENT_UPLOAD_TOKEN_HEADER=x-upload-token
DOCUMENT_PREVIEW_TOKEN_HEADER=x-preview-token
IDEMPOTENCY_TTL_SECONDS=86400
SIGNING_SESSION_TTL_SECONDS=604800
SIGNING_SESSION_COOKIE_NAME=esign_sign
SIGNING_CSRF_COOKIE_NAME=esign_sign_csrf
SIGNING_RATE_LIMIT_MAX=30
SIGNING_RATE_LIMIT_WINDOW_MS=60000
SIGNING_CONSENT_COPY_ID=esign-disclosure-v1
SIGNING_CONSENT_VERSION=1
SIGNING_CONSENT_TITLE=Electronic signature consent
SIGNING_CONSENT_TEXT=By selecting Agree, you confirm that you have reviewed this document and intend to sign electronically. This text is a product placeholder and is not legal advice.
DOCUMENT_FIELD_OVERLAP_POLICY=prohibit
NOTIFICATION_ADAPTER=local
NOTIFICATION_PREVIEW_DIR=tmp/signing-notifications
# local inspector is NON-PRODUCTION. Production must use fail_closed until a real scanner is wired.
# local notifier writes preview files and omits raw tokens when NODE_ENV=production.


# PostgreSQL (local Docker Compose)
POSTGRES_USER=esign
POSTGRES_PASSWORD=esign_dev_password
POSTGRES_DB=esign
POSTGRES_PORT=5432
DATABASE_URL=postgresql://esign:esign_dev_password@localhost:5432/esign

# MinIO (local object storage; private bucket; not for production)
MINIO_ROOT_USER=esignminio
MINIO_ROOT_PASSWORD=esignminio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=esign-documents
OBJECT_STORAGE_ACCESS_KEY=esignminio
OBJECT_STORAGE_SECRET_KEY=esignminio_dev_password
OBJECT_STORAGE_FORCE_PATH_STYLE=true
