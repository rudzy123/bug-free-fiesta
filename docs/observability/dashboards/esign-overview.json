{
  "__inputs": [],
  "title": "eSign — Platform overview",
  "uid": "esign-overview",
  "schemaVersion": 39,
  "editable": true,
  "tags": ["esign", "observability"],
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate by status class",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status_class) (rate(esign_http_requests_total[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API latency p50/p95/p99 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(esign_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(esign_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(esign_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP errors by code",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (code) (rate(esign_http_errors_total[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DB readiness ping latency p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(esign_db_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue depth by state",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "esign_queue_depth",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Finalization duration p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(esign_job_duration_seconds_bucket{type=\"flatten_signature\",outcome=\"succeeded\"}[1h])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Audit verification failures (24h)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "targets": [{ "expr": "increase(esign_audit_verification_failures_total[24h])" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Signing completions by outcome",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(esign_signing_completions_total[15m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Object-storage & PDF failures",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(esign_object_storage_errors_total[15m]))",
          "legendFormat": "storage errors"
        },
        {
          "expr": "sum by (category) (rate(esign_pdf_failures_total[15m]))",
          "legendFormat": "pdf {{category}}"
        }
      ]
    }
  ]
}
