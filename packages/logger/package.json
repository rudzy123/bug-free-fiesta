{
  "name": "@esign/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "audit:redaction": "tsx src/redaction-audit.cli.ts"
  },
  "dependencies": {
    "pino": "9.6.0"
  },
  "devDependencies": {
    "@esign/eslint-config": "workspace:*",
    "@esign/typescript-config": "workspace:*",
    "@types/node": "22.15.18",
    "eslint": "9.27.0",
    "tsx": "4.19.4",
    "typescript-eslint": "8.32.1",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
