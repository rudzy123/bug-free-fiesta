{
  "name": "@esign/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./factories": {
      "types": "./dist/factories.d.ts",
      "import": "./dist/factories.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "DATABASE_URL=${DATABASE_URL:-postgresql://esign:esign_dev_password@localhost:5432/esign} prisma generate && tsc -p tsconfig.json && rm -rf dist/generated && cp -R src/generated dist/generated",
    "typecheck": "DATABASE_URL=${DATABASE_URL:-postgresql://esign:esign_dev_password@localhost:5432/esign} prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://esign:esign_dev_password@localhost:5432/esign} prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx src/seed.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:diff": "prisma migrate diff --from-url \"${DATABASE_URL:-postgresql://esign:esign_dev_password@localhost:5432/esign}\" --to-schema-datamodel prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@esign/domain": "workspace:*",
    "@prisma/client": "6.8.2"
  },
  "devDependencies": {
    "@esign/eslint-config": "workspace:*",
    "@esign/typescript-config": "workspace:*",
    "@types/node": "22.15.18",
    "eslint": "9.27.0",
    "typescript-eslint": "8.32.1",
    "prisma": "6.8.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  }
}
